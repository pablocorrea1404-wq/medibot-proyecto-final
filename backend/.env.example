# =======================================================
# MediBot Dental OS - Backend Environment Configuration
# =======================================================

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=your_app_secret_here_generate_with_openssl

# Base de datos (MariaDB / MySQL en Docker o local)
DATABASE_URL="mysql://user:password@127.0.0.1:3306/medibot?serverVersion=10.6.12-MariaDB&charset=utf8mb4"
DEFAULT_URI=http://localhost:8000

# CORS y Dominio permitido
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# JWT Authentication (si aplica)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your_jwt_passphrase_here
